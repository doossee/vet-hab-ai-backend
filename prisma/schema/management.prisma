model Region {
  id Int @id @default(autoincrement())

  name      String     @unique @db.VarChar(40)
  districts District[]
}

model District {
  id Int @id @default(autoincrement())

  name     String @db.VarChar(40)
  regionId Int    @map("region_id")
  region   Region @relation(fields: [regionId], references: [id], onDelete: Cascade)

  users       User[]
  vetStations VetStation[]
}

model VetStation {
  id Int @id @default(autoincrement())

  name    String @db.VarChar(40)
  address String @db.VarChar(80)

  districtId Int      @map("district_id")
  district   District @relation(fields: [districtId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
}

model AnimalType {
  id Int @id @default(autoincrement())

  name    String   @db.VarChar(40)
  animals Animal[]
}

model Breed {
  id Int @id @default(autoincrement())

  name     String
  parentId Int?   @map("parent_id")
  parent   Breed? @relation("BreedToParent", fields: [parentId], references: [id])

  children Breed[]  @relation("BreedToParent")
  animals  Animal[]
}

model Color {
  id Int @id @default(autoincrement())

  name String  @db.VarChar(40)
  hex  String? @db.VarChar(8)

  animals            Animal[]
  generalInspections GeneralInspection[]
}

model UrineColor {
  id Int @id @default(autoincrement())

  name String @db.VarChar(40)

  urineTests UrineTest[]
}

model DungColor {
  id Int @id @default(autoincrement())

  name String @db.VarChar(40)

  dungTests DungTest[]
}

model LeatherCover {
  id Int @id @default(autoincrement())

  name String @db.VarChar(40)

  generalInspections GeneralInspection[]
}

model Eyelid {
  id Int @id @default(autoincrement())

  name String @db.VarChar(40)

  generalInspections GeneralInspection[]
}

model VaccineType {
  id Int @id @default(autoincrement())

  name String @db.VarChar(40)

  vaccines Vaccine[]
}

model DiseaseType {
  id Int @id @default(autoincrement())

  name String @db.VarChar(40)

  diseases Disease[]
}
