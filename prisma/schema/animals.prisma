model Animal {
  id Int @id @default(autoincrement())

  idCode      String
  arrivalDate DateTime

  farmerId Int
  farmer   Farmer @relation(fields: [farmerId], references: [id])

  typeId Int
  type   AnimalType @relation(fields: [typeId], references: [id])

  name   String
  gender Gender
  breed  Breed

  birthDate DateTime
  weight    Float

  colorId Int
  color   Color @relation(fields: [colorId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vaccines Vaccine[]
  diseases Disease[]

  generalInspection GeneralInspection[]
  generalBloodTests GeneralBloodTest[]
  bloodSerumTests   BloodSerumTest[]

  inspection Inspection[]
  urineTests UrineTest[]
  dungTests  DungTest[]
}

model Vaccine {
  id Int @id @default(autoincrement())

  date DateTime

  typeId Int
  type   VaccineType @relation(fields: [typeId], references: [id])

  animalId Int
  animal   Animal @relation(fields: [animalId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
