model User {
  id Int @id @default(autoincrement())

  phone    String @unique
  password String

  firstName  String  @map("first_name")
  lastName   String  @map("last_name")
  middleName String? @map("middle_name")

  gender     Gender?
  birthDate  DateTime? @map("birth_date")
  districtId Int       @map("district_id")
  district   District  @relation(fields: [districtId], references: [id])
  address    String?
  role       UserRole

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  veterinarianData Veterinarian?
  farmerData       Farmer?
}

model Veterinarian {
  userPtrId Int  @id @default(autoincrement()) @map("user_ptr_id")
  user      User @relation(fields: [userPtrId], references: [id], onDelete: Cascade)

  farmers Farmer[]

  @@unique([userPtrId])
}

model Farmer {
  userPtrId Int  @id @default(autoincrement()) @map("user_ptr_id")
  user      User @relation(fields: [userPtrId], references: [id], onDelete: Cascade)

  veterinarianId Int          @map("veterinarian_id")
  veterinarian   Veterinarian @relation(fields: [veterinarianId], references: [userPtrId])

  animals Animal[]

  @@unique([userPtrId])
}
