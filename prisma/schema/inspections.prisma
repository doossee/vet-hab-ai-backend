model GeneralInspection {
  id Int @id @default(autoincrement())

  animalId Int    @map("animal_id")
  animal   Animal @relation(fields: [animalId], references: [id], onDelete: Cascade)

  // Gabitus

  bodyType      BodyType      @map("body_type") // jussasi
  bodyStructure BodyStructure @map("body_structure") // tana tuzilishi
  bodyPosition  BodyPosition  @map("body_position")
  obesity       ObesityType // semizligi
  character     CharacterType // hayvon mijozi gabitus         Gabitus?

  leatherCoverId Int          @map("leather_cover_id")
  leatherCover   LeatherCover @relation(fields: [leatherCoverId], references: [id])

  eyelidId Int    @map("eyelid_id")
  eyelid   Eyelid @relation(fields: [eyelidId], references: [id])

  colorId Int   @map("color_id")
  color   Color @relation(fields: [colorId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  inspection Inspection?
}

model Inspection {
  id Int @id @default(autoincrement())

  animalId Int?    @map("animal_id")
  animal   Animal? @relation(fields: [animalId], references: [id], onDelete: Cascade)

  diseaseId Int?     @map("disease_id")
  disease   Disease? @relation(fields: [diseaseId], references: [id], onDelete: Cascade)

  generalInspectionId Int?               @unique @map("general_inspection_id")
  generalInspection   GeneralInspection? @relation(fields: [generalInspectionId], references: [id], onDelete: Cascade)

  temperature     Float? // temperatura
  pulse           Int? // puls
  respiratoryRate Float? @map("respiratory_rate") // nafas soni
  rumination      Int? // ruminatsiya

  type       InspectionType
  conclusion String?        @db.Text()

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
}

model Disease {
  id Int @id @default(autoincrement())

  animalId Int    @map("animal_id")
  animal   Animal @relation(fields: [animalId], references: [id], onDelete: Cascade)

  typeId Int         @map("type_id")
  type   DiseaseType @relation(fields: [typeId], references: [id])

  startTime DateTime @map("start_time")
  endTime   DateTime @map("end_time")

  conclusion String? @db.Text()

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  inspections Inspection[]
  urineTests  UrineTest[]
  dungTests   DungTest[]
}

model GeneralBloodTest {
  id Int @id @default(autoincrement())

  date       DateTime // sana 
  conclusion String?  @db.Text() // xulosa

  erythrocyteCount Float? @map("erythrocyte_count") // eritrosit soni
  leukocyteCount   Float? @map("leukocyte_count") // leykosit soni
  thrombocyteCount Float? @map("thrombocyte_count") // trobmasit soni

  coe                  Float? // COE
  waterPercentage      Float? @map("water_percentage") // suv foizda
  dryResiduePercentage Float? @map("dry_residue_percentage") // quruq qoldiq
  hemoglobin           Float? // gemoglobin
  glutathione          Float? // glutation

  animalId Int    @map("animal_id")
  animal   Animal @relation(fields: [animalId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
}

model BloodSerumTest {
  id Int @id @default(autoincrement())

  totalProtein      Float? @map("total_protein") // umumiy oqsil
  totalCalcium      Float? @map("total_calcium") // umumiy kalsiy
  organicPhosphorus Float? @map("organic_phosphorus") // organik fosfor
  albumen           Float? // albumin
  alphaGlobulin     Float? @map("alpha_globulin") // alfa globulin
  betaGlobulin      Float? @map("beta_globulin") // beta globulin
  gammaGlobulin     Float? @map("gamma_globulin") // gamma globulin
  creatine          Float? // kreatin
  alkalineReserve   Float? @map("alkaline_reserve") // ishqoriy zahira
  glucose           Float? // glyukoza
  totalBilirubin    Float? @map("total_bilirubin") // umumiy bilirubin
  cholesterol       Float? // xolesterin
  totalLipids       Float? @map("total_lipids") // umumiy lipidlar
  vitaminA          Float? @map("vitamin_a") // vitamin A
  vitaminB          Float? @map("vitamin_b") // vitamin B
  lacticAcid        Float? @map("lactic_acid") // laktik kislotasi
  pyruvicAcid       Float? @map("pyruvic_acid") // pirouzum kislotasi
  citricAcid        Float? @map("citric_acid") // limon kislotasi
  urea              Float? // siydik
  ureaAcid          Float? @map("urea_acid") // siydik kislotasi

  animalId Int    @map("animal_id")
  animal   Animal @relation(fields: [animalId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
}

model UrineTest {
  id Int @id @default(autoincrement())

  animalId Int?    @map("animal_id")
  animal   Animal? @relation(fields: [animalId], references: [id], onDelete: Cascade)

  diseaseId Int?     @map("disease_id")
  disease   Disease? @relation(fields: [diseaseId], references: [id], onDelete: Cascade)

  colorId Int        @map("color_id")
  color   UrineColor @relation(fields: [colorId], references: [id])

  clarity     UrineClarity
  consistency Int
  smell       SmellType

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
}

model DungTest {
  id Int @id @default(autoincrement())

  animalId Int?    @map("animal_id")
  animal   Animal? @relation(fields: [animalId], references: [id], onDelete: Cascade)

  diseaseId Int?     @map("disease_id")
  disease   Disease? @relation(fields: [diseaseId], references: [id], onDelete: Cascade)

  colorId Int       @map("color_id")
  color   DungColor @relation(fields: [colorId], references: [id])

  clarity     DungClarity
  smell       SmellType
  form        DungForm
  consistency Int
  worms       Int

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
}
