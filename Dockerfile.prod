# ================================
# Stage 1: Build
# ================================
FROM node:22-alpine AS builder

WORKDIR /app

# Prisma's engines need OpenSSL; Alpine ships without it.
RUN apk add --no-cache openssl

# Install all dependencies (incl. dev deps: nest CLI, ts-node, prisma CLI)
# .npmrc (legacy-peer-deps) must be present so npm ci resolves the
# nestjs-prisma peer conflict before install runs.
COPY package*.json .npmrc ./
RUN npm ci

# Prisma schema (multi-file folder) must be present before generate
COPY prisma ./prisma

# Dummy URL so `prisma generate` can evaluate the datasource block
ENV DATABASE_URL="postgresql://dummy:dummy@localhost:5432/dummy?schema=public"
RUN npx prisma generate

# Build Nest app -> dist
COPY . .
RUN npm run build

# ================================
# Stage 2: Production
# ================================
FROM node:22-alpine AS production

WORKDIR /app
ENV NODE_ENV=production
ENV CHECKPOINT_DISABLE=1

# Prisma's engines need OpenSSL at runtime too.
RUN apk add --no-cache openssl

# node_modules from builder: carries the generated Prisma client and the
# prisma CLI so the entrypoint can run `migrate deploy` at startup.
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/dist ./dist
COPY --from=builder /app/prisma ./prisma
COPY package*.json ./
COPY tsconfig.json ./
COPY docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh
RUN chmod +x /usr/local/bin/docker-entrypoint.sh

EXPOSE 3000

# TCP healthcheck (no /health route exists); succeeds once the server binds.
HEALTHCHECK --interval=30s --timeout=3s --start-period=60s --retries=3 \
    CMD node -e "require('net').connect(process.env.PORT||3000,'127.0.0.1').on('connect',()=>process.exit(0)).on('error',()=>process.exit(1))"

ENTRYPOINT ["docker-entrypoint.sh"]
CMD ["node", "dist/main"]
